DAEMON_PATH=/home/cloud_user/kafka-2/bin
#DAEMON_PATH=/home/cloud_user/kafka_2.12-3.4.0/bin
DAEMON_NAME=kafka
PATH=$PATH:$DAEMON_PATH
CONFIG_PATH=/home/cloud_user/kafka-2/config/server.properties
#CONFIG_PATH=/home/cloud_user/kafka_2.12-3.4.0/config/server.properties

case "$1" in
  start)
        # Start daemon.
        pid=`ps ax | grep -i 'kafka.Kafka' | grep -v grep | awk '{print $1}'`
        if [ -n "$pid" ]
          then
            echo "Kafka is already running"
        else
          echo "Starting $DAEMON_NAME"
          $DAEMON_PATH/kafka-server-start.sh -daemon $CONFIG_PATH
        fi
        ;;
  stop)
        echo "Shutting down $DAEMON_NAME"
        $DAEMON_PATH/kafka-server-stop.sh
        ;;
  restart)
        $0 stop
        sleep 2
        $0 start
        ;;
  status)
        pid=`ps ax | grep -i 'kafka.Kafka' | grep -v grep | awk '{print $1}'`
        if [ -n "$pid" ]
          then
          echo "Kafka is Running as PID: $pid"
        else
          echo "Kafka is not Running"
        fi
        ;;
  *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
esac

exit 0
